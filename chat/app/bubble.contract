use Message, Secondary, arrive, appear, receipt, fade, dot, markIn, markOut from "./types.contract"

// Calendar days from `at` to `now`, both at the offset
fn daysBetween(at: number, now: number, offset: number): number = floor((now + offset * 60000) / 86400000) - floor((at + offset * 60000) / 86400000)

// The day a stamp names: Today or Yesterday, the weekday two to six days
// back, else the date
fn stampDay(at: number, now: number, offset: number): string = daysBetween(at, now, offset) >= 2 and daysBetween(at, now, offset) <= 6 ? formatDay(at, now, offset, "list") : formatDay(at, now, offset, "day")

// Keep every painted part on the same viewport gradient, including the tail
style Sent
  background-color="light-dark(#0088ff, #0091ff)"
  background-image="linear-gradient(to bottom, light-dark(#5ac8fa, #409cff), light-dark(#0088ff, #0091ff))"
  background-attachment="fixed"

style Received
  background-color="light-dark(#e9e9eb, #262629)"

// The balloon's outline. The body is W x H with Apple's continuous corners of
// radius r, half the natural one-line height. Each half corner has a budget,
// half its side up to 1.5286655r, and its control points move linearly from a
// circular corner (budget r) to the full continuous corner. The tail replaces
// the corner at the tail's side with a fixed curve below the body. Points are
// written for a tail on the right and mirrored about the box for one on the
// left.
fn point(left: bool, width: number, x: number, y: number): string = `${(left ? width - x : x).toFixed(3)} ${y.toFixed(3)}`

component Balloon
  props
    body: string
    mine: bool
    tail: bool
    bodySize: number
    identifier: string
    // How far left of its place the text is drawn, and how it moves there:
    // a send starts with it where the field had it
    shift: number
    shiftMotion: string
    // How the tail goes and comes, when a later message takes it or gives it back
    tailMotion: string
  state width = 0
  state height = 0
  // Its padding around the text; the outline is drawn around both
  derive padX = 14
  derive padY = 8
  // The root's content box, as `resize` reports it, with that padding back
  action measured(w: number, h: number)
    width = w + 2 * padX
    height = h + 2 * padY
  // The first line is the font's natural height; later lines the line box
  derive lead = bodySize * 1.193359 - (bodySize + 3)
  derive r = (bodySize * 1.193359 + 20) / 2
  derive k = r / 20.14355
  derive eMax = r * 1.5286655
  derive eV = min(height / 2, eMax)
  derive eH = min(width / 2, eMax)
  derive uV = (eV - r) / (eMax - r)
  derive uH = (eH - r) / (eMax - r)
  derive left = not mine
  derive c1V = r * (0.8732607 + uV * 0.2152297)
  derive c2pV = r * (0.0240926 + uV * -0.0240926)
  derive c2aV = r * (0.7476761 + uV * 0.1207310)
  derive endpV = r * (0.0709944 + uV * 0.0039169)
  derive endaV = r * (0.6299341 + uV * 0.0015598)
  derive midpV = r * (0.1726399 + uV * -0.0035798)
  derive midaV = r * (0.3747661 + uV * -0.0019421)
  derive c1H = r * (0.8732607 + uH * 0.2152297)
  derive c2pH = r * (0.0240926 + uH * -0.0240926)
  derive c2aH = r * (0.7476761 + uH * 0.1207310)
  derive endpH = r * (0.0709944 + uH * 0.0039169)
  derive endaH = r * (0.6299341 + uH * 0.0015598)
  derive midpH = r * (0.1726399 + uH * -0.0035798)
  derive midaH = r * (0.3747661 + uH * -0.0019421)
  derive topLeft = `M ${point(left, width, 0, eV)} C ${point(left, width, 0, c1V)} ${point(left, width, c2pV, c2aV)} ${point(left, width, endpV, endaV)} C ${point(left, width, midpV, midaV)} ${point(left, width, midaH, midpV)} ${point(left, width, endaH, endpH)} C ${point(left, width, c2aH, c2pH)} ${point(left, width, c1H, 0)} ${point(left, width, eH, 0)}`
  derive topRight = `L ${point(left, width, width - eH, 0)} C ${point(left, width, width - c1H, 0)} ${point(left, width, width - c2aH, c2pH)} ${point(left, width, width - endaH, endpH)} C ${point(left, width, width - midaH, midpH)} ${point(left, width, width - midpH, midaV)} ${point(left, width, width - endpV, endaV)} C ${point(left, width, width - c2pV, c2aV)} ${point(left, width, width, c1V)} ${point(left, width, width, eV)} L ${point(left, width, width, height - eV)}`
  derive tailCorner = `C ${point(left, width, width, height - k * 15.80647)} ${point(left, width, width - k * 1.42506, height - k * 11.58438)} ${point(left, width, width - k * 4.05681, height - k * 8.13379)} C ${point(left, width, width - k * 5.12321, height - k * 6.73577)} ${point(left, width, width - k * 6.35449, height - k * 5.50354)} ${point(left, width, width - k * 7.71498, height - k * 4.45517)} C ${point(left, width, width - k * 9.65380, height - k * 2.94340)} ${point(left, width, width - k * 10.49278, height - k * 1.36616)} ${point(left, width, width - k * 10.49278, height + k * 0.40647)} C ${point(left, width, width - k * 10.49278, height + k * 1.59796)} ${point(left, width, width - k * 10.28228, height + k * 2.77536)} ${point(left, width, width - k * 8.57108, height + k * 5.02338)} C ${point(left, width, width - k * 7.75023, height + k * 6.10106)} ${point(left, width, width - k * 8.57410, height + k * 7.20089)} ${point(left, width, width - k * 9.85725, height + k * 6.71342)} C ${point(left, width, width - k * 12.49605, height + k * 5.71128)} ${point(left, width, width - k * 15.50147, height + k * 3.88728)} ${point(left, width, width - k * 18.13424, height + k * 1.94041)} C ${point(left, width, width - k * 20.49305, height + k * 0.19597)} ${point(left, width, width - k * 21.12152, height + k * 0.01972)} ${point(left, width, width - k * 22.22841, height + k * 0.01267)} L ${point(left, width, width - eH, height)}`
  derive roundCorner = `C ${point(left, width, width, height - c1V)} ${point(left, width, width - c2pV, height - c2aV)} ${point(left, width, width - endpV, height - endaV)} C ${point(left, width, width - midpH, height - midaV)} ${point(left, width, width - midaH, height - midpH)} ${point(left, width, width - endaH, height - endpH)} C ${point(left, width, width - c2aH, height - c2pH)} ${point(left, width, width - c1H, height)} ${point(left, width, width - eH, height)}`
  derive bottomLeft = `L ${point(left, width, eH, height)} C ${point(left, width, c1H, height)} ${point(left, width, c2aH, height - c2pH)} ${point(left, width, endaH, height - endpH)} C ${point(left, width, midaH, height - midpH)} ${point(left, width, midpH, height - midaV)} ${point(left, width, endpV, height - endaV)} C ${point(left, width, c2pV, height - c2aV)} ${point(left, width, 0, height - c1V)} ${point(left, width, 0, height - eV)} Z`
  derive outline = `${topLeft} ${topRight} ${roundCorner} ${bottomLeft}`
  // The tail is what lies between the tail's curve and the round corner it
  // replaces: the tail's curve out to the bottom edge, then the corner's
  // curves back to where both start
  derive cornerBack = `C ${point(left, width, width - c1H, height)} ${point(left, width, width - c2aH, height - c2pH)} ${point(left, width, width - endaH, height - endpH)} C ${point(left, width, width - midaH, height - midpH)} ${point(left, width, width - midpH, height - midaV)} ${point(left, width, width - endpV, height - endaV)} C ${point(left, width, width - c2pV, height - c2aV)} ${point(left, width, width, height - c1V)} ${point(left, width, width, height - eV)} Z`
  derive tailShape = `M ${point(left, width, width, height - eV)} ${tailCorner} ${cornerBack}`
  // Where the tail shrinks to, inside the body's corner
  derive tailOrigin = `${(left ? eH : width - eH).toFixed(3)}px ${(height - eV).toFixed(3)}px`
  view
    // Text narrower than the balloon's smallest width sits in its middle;
    // wider text fills the balloon, its lines left-aligned
    box id=identifier testId=identifier position="relative" display="flex" justify-content="center" min-width=48 max-width="100%" box-sizing="border-box" padding=`${padY}px ${padX}px` resize=measured
      // Paint nothing until the first measurement gives the outline its size.
      // The tail lies under the body, so it shrinks into it.
      box position="absolute" left=0 top=0 right=0 bottom=-8 class=(mine ? Sent : Received) clip-path=`path('${tailShape}')` opacity=(width > 0 and tail ? 1 : 0) scale=(tail ? 1 : 0) transform-origin=tailOrigin transition=tailMotion aria-hidden=true pointer-events="none"
      box position="absolute" left=0 top=0 right=0 bottom=-8 class=(mine ? Sent : Received) clip-path=`path('${outline}')` opacity=(width > 0 ? 1 : 0) aria-hidden=true pointer-events="none"
      // Keep the 10-point inset while allowing ink beyond the tight line box.
      // The first line sits at the font's natural height, so the lead
      // over the line box goes half above the text and half below.
      text body id=`${identifier}-text` testId=`${mine ? "outgoing" : "incoming"}-text-${identifier}` position="relative" padding=`${2 + lead / 2}px 0px` font-size="1rem" line-height=`${bodySize + 3}px` font-family="system-ui" color=(mine ? "light-dark(#ffffff, #ffffff)" : "light-dark(#000000, #ffffff)") white-space="pre-wrap" overflow-wrap="break-word" hyphens=(bodySize > 23 ? "auto" : "manual") text-align="left" min-width=0 translate=`${shift}px 0px` transition=shiftMotion

// Rows are laid out by their balloons' bodies: a tail paints into the
// space below its row and never moves another. A run's last row keeps room
// for it, and the row holding the receipt room for that instead. A room
// takes its height with the change that gives it, and the list moves the
// rows that change shifts, all on one spring, as a collection view's batch
// update does. When the receipt moves on, the old words fade in 100 ms as
// they leave (a fade, which reduced motion keeps), and the new ones grow
// about their centre once those are gone. Only the receipt's row holds its
// words.
component MessageRow
  props
    message: Message
    receiptId: string
    now: number
    // Minutes east of UTC, where the stamp and the receipt's times are read
    utcOffset: number
    bodySize: number
    reduced: bool
    hidden: bool
    // Just received: it pops in from its tail's corner
    arriving: bool
    aim: action
    replyTo: action
    // Choosing messages (a balloon's More…): whether this one is chosen,
    // and what a tap on its row does then
    choosing: bool
    chosen: bool
    choose: action
  derive hasReceipt = message.id == receiptId
  derive tail = message.endsRun
  // The receipt's room is its offset, its line and 1 point: 19.333 at the
  // default text size. The last row's tail paints into the transcript's foot.
  derive room = hasReceipt ? 6.3333 + bodySize * 0.764706 : (tail and not message.last ? 6.65 : 0)
  // Choosing begins and ends in 0.3 s on the default curve, as the platform's does
  derive chooseMotion = reduced ? "none" : "300ms ease-in-out"
  view
    // Rows keep the platform's layout margins (the safe area and UIKit's
    // minimum beside it, 0 beside the iPhone Duo's side strip), 16 points
    // where a host has none. A stamp sits 14.67 points under the run before it, which that run's
    // room for its tail and its padding make, and 9 over its balloon.
    // Choosing, a mark sits 11 points in from the safe area, centred on the
    // row, and a received balloon moves to start 20 points after it, where
    // a sent one stays; the row's receipt hides, and a tap anywhere on the
    // row chooses it (the platform's selection mode), the row's one element
    // for VoiceOver then
    column testId=`row-${message.id}` position="relative" padding-left="max(16px, var(--exact-layout-margins-inset-left))" padding-right="max(16px, var(--exact-layout-margins-inset-right))" padding-top=(message.stamped ? 0 : 2) padding-bottom=(message.endsRun and not message.last ? 8 : 2) box-sizing="border-box"
      // The day bold and the time regular: "Today 9:41 AM", "Monday 6:12 PM".
      // A sent row's comes in where it is as its balloon flies there.
      if message.stamped
        text testId=`stamp-${message.id}` class=Secondary text-align="center" font-size="0.647059rem" line-height="0.764706rem" margin-bottom=9 animation=(hidden and not reduced ? "appear 300ms ease-out both" : "none")
          text stampDay(message.at, now, utcOffset) font-weight=600
          text ` ${formatTime(message.at, utcOffset, "short")}`
      if message.reply != ""
        row justify-content=(message.mine ? "flex-end" : "flex-start") margin-bottom=6 aria-hidden=choosing margin-left=(choosing and not message.mine ? "calc(var(--exact-safe-area-inset-left) + 57px - max(16px, var(--exact-layout-margins-inset-left)))" : "0px") -exact-layout-transition=chooseMotion
          text message.reply class=Secondary border-left="2px solid -exact-separator" padding-left=8 max-width="85%" font-size="0.764706rem" line-clamp=2
      box align-self=(message.mine ? "flex-end" : "flex-start") opacity=(hidden ? 0 : 1) aria-hidden=choosing max-width="min(85%, calc(100% - 89.333333px))" contextmenu=aim(message.id, message.body) contextPopover="message-menu" swiperight=replyTo(message.body) touch-action="pan-y" animation=(arriving and not reduced ? "arrive 220ms ease-out both" : "none") transform-origin="0% 100%" margin-left=(choosing and not message.mine ? "calc(var(--exact-safe-area-inset-left) + 57px - max(16px, var(--exact-layout-margins-inset-left)))" : "0px") -exact-layout-transition=chooseMotion
        Balloon(body=message.body, mine=message.mine, tail=tail, bodySize=bodySize, identifier=`bubble-${message.id}`, shift=0, shiftMotion="none", tailMotion=(reduced ? "none" : "scale -exact-spring(438.649, 41.8879, 1), opacity -exact-spring(438.649, 41.8879, 1)"))
      column height=room flex-shrink=0 pointer-events="none" opacity=(choosing ? 0 : 1)
        if message.mine and hasReceipt
          text (message.receipt == "Read" and message.readAt > 0 ? `Read ${formatDay(message.readAt, now, utcOffset, "list")}` : (message.receipt != "" ? message.receipt : "Delivered")) testId=`receipt-${message.id}` class=Secondary align-self="flex-end" font-size="0.647059rem" line-height="0.764706rem" font-weight=600 margin-top=5.3333 margin-right=19.667 animation=(hasReceipt and message.receipt == "" and now - message.at < 1900 and not reduced ? "receipt 610ms cubic-bezier(0.25, 1, 0.5, 1) 100ms backwards" : "none") -exact-exit-animation="fade 100ms ease-out both"
      if choosing
        row position="absolute" top=0 bottom=0 left="calc(var(--exact-safe-area-inset-left) + 11px)" align-items="center" pointer-events="none" animation=(reduced ? "none" : "markIn 300ms ease-in-out both") -exact-exit-animation="markOut 300ms ease-in-out both" aria-hidden=true
          image (chosen ? "symbol:select-fill" : "symbol:circle") font-size=22 testId=`mark-${message.id}` color=(chosen ? "-exact-system-blue" : "-exact-tertiary-label") -exact-symbol-rendering="palette" -exact-symbol-palette=(chosen ? "#ffffff -exact-system-blue" : "-exact-tertiary-label")
        button appearance="none" position="absolute" inset=0 press=choose(message.id) role="checkbox" aria-checked=chosen aria-label=message.body testId=`choose-${message.id}`

component Typing
  props
    name: string
    reduced: bool
  view
    row testId="typing-indicator" aria-label=`${name} is typing` gap=4 align-items="center" justify-content="center" width=58 height=36 border-radius=18 class=Received margin-left="max(16px, var(--exact-layout-margins-inset-left))" margin-top=8 margin-bottom=4
      box width=8.5 height=8.5 border-radius=4.25 background-color="light-dark(#00000033, #ffffff66)" animation=(reduced ? "none" : "dot 500ms ease-in-out infinite alternate")
      box width=8.5 height=8.5 border-radius=4.25 background-color="light-dark(#00000033, #ffffff66)" animation=(reduced ? "none" : "dot 500ms 250ms ease-in-out infinite alternate")
      box width=8.5 height=8.5 border-radius=4.25 background-color="light-dark(#00000033, #ffffff66)" animation=(reduced ? "none" : "dot 500ms 500ms ease-in-out infinite alternate")
