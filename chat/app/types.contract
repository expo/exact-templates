shape Message
  id: string
  body: string
  mine: bool
  at: number
  reply: string
  // The time heads it: the conversation's first message, or one sent an
  // hour or more after the one before
  stamped: bool
  endsRun: bool
  last: bool
  receipt: string
  // When it was read, for a receipt that says "Read"
  readAt: number

// A person in the list of conversations with their conversation
shape Thread
  id: string
  name: string
  short: string
  initials: string
  // Fictional, as `model.ts` says
  phone: string
  email: string
  // The unsent draft and the message it replies to
  draft: string
  reply: string
  // How many messages were sent and received in it, deleted ones too: the
  // next is numbered one more (`sent-<n>`)
  serial: number
  messages: Message[]

// A message a search found: its conversation, and its text trimmed around
// the match, with the match split out to be highlighted (`model.ts`, `found`)
shape Found
  key: string
  thread: string
  name: string
  initials: string
  message: string
  at: number
  mine: bool
  before: string
  match: string
  after: string

shape Change
  id: string
  error: string

shape Viewport
  height: number
  prefersReducedMotion: bool
  accessibilityTextSize: bool

shape Time
  epochAtZero: number
  utcOffset: number

style Ink
  color="light-dark(#000000, #ffffff)"

style Secondary
  color="-exact-secondary-label"

// A contact with no photo: initials in the rounded face on a circle that
// lightens toward its top
style Avatar
  background-color="light-dark(#5f6a7d, #5f6a7d)"
  background-image="linear-gradient(to bottom, #737f94, #4e5868)"

style Initials
  font-family="ui-rounded" font-weight=600 color="light-dark(#ffffff, #ffffff)"

// The platform's page: white or black, and in dark mode gray where UIKit
// raises it (a context menu's preview, a sheet)
style Canvas
  background-color="-exact-background"

style GlassButton
  width=40 height=40 border-radius=20 flex-shrink=0
  display="flex" align-items="center" justify-content="center"

// A row of the + card: a 38-point tile 34 points in, the label 27 points
// after it
style CardRow
  display="flex" flex-direction="row" align-items="center" gap=27 min-height=56 padding-left=34 padding-right=24 text-align="left"

style CardTile
  width=38 height=38 border-radius=19 flex-shrink=0
  display="flex" align-items="center" justify-content="center"

style CardGlyph
  font-size="1.058824rem" color="light-dark(#ffffff, #ffffff)"

// A received balloon pops in from its tail's corner
keyframes arrive
  from opacity=0 scale=0.9
  to opacity=1 scale=1

keyframes receipt
  from opacity=0 scale=0.21
  22% opacity=1
  to opacity=1 scale=1

// The receipt's old words as they leave
keyframes fade
  to opacity=0

// A part of a new row that comes in where it is
keyframes appear
  from opacity=0

// A selection mark slides in from beyond the leading edge, and out to it
keyframes markIn
  from translate="-37px 0px"
keyframes markOut
  to translate="-37px 0px"

keyframes dot
  from opacity=0.2
  to opacity=0.45
