use Message, Thread, Window, ChosenMessage, Found, Change, Viewport, Time, Canvas, Ink, Secondary, CardRow, CardTile, CardGlyph, Avatar, Initials, fade from "./types.contract"
use MessageRow, Typing, Balloon, Sent, Received from "./bubble.contract"
use Composer, ChoiceBar from "./composer.contract"
use EmptyState from "exact:content"

// The conversation is pushed over the list of conversations, so it has the
// platform's Back. A wide window (an iPad, the iPhone Duo open) shows
// the list beside it, its rows links so the split marks the open one selected.
routes nav
  inbox "/"
    thread "/conversations/:id"

component ExactChat
  // The draft and reply of `editing`, the conversation being written in;
  // another's are the ones saved with it
  state editing = ""
  state editedDraft = ""
  state editedReply = ""
  state submitted = ""
  state submittedReply = ""
  state typing = false
  // The list's search: the conversations whose name matches (`shown`), then the messages whose text does (`matches`)
  state query = ""
  state selectedId = ""
  state selectedBody = ""
  state elapsed = 0
  state bodySize = 17
  // A send's flight: a copy of the balloon starts under the field's glass, its
  // text where the field had it, and goes to its row. Phases: 1 laid out but
  // not shown, 2 shown as the field, 3 narrowing, shrinking and sliding to the
  // row's side, rising from 55 ms in, 4 growing back, from 185 ms in.
  state flightPhase = 0
  state flightId = ""
  state flightBody = ""
  state flightAt = 0
  state squashAt = 0
  // Where the copy is laid out in the conversation: across the transcript's
  // rows, its bottom at the field's
  state flightLeft = 0
  state flightRight = 0
  state flightBottom = 0
  state fieldX = 0
  state fieldRight = 0
  state flierBottom = 0
  state flightScale = 1
  state flightSlide = 0
  state flightReach = 0
  state flightNarrow = 0
  state flightShift = 0
  state flightRise = 0
  state arrivedId = ""
  // The conversation the list's long-press menu was opened on
  state peeked = ""
  // The person whose card a long press on their avatar in the list shows
  state carded = ""
  // Choosing messages, from a balloon's More…: the ones chosen to delete or
  // share
  state choosing = false
  state chosen: string[] = []
  state picked: ChosenMessage[] = []
  // The part of the open conversation its transcript shows, as ChatKit loads
  // it: its latest messages, which the list answers with it, until the
  // reader reaches the first; then a window of the conversation, between
  // these cursors, which loads more at each edge it reaches
  state windowStart = ""
  state windowEnd = ""
  // The conversation last opened, kept across launches. Beside the list one
  // is always selected: this one, else the newest. A phone opens at the list
  state selected = "" persist
  resource viewport = exactViewport() as shape Viewport
  resource wall = exactTime() as shape Time
  resource inbox = loadInbox() as shape Thread[] else empty()
  derive windowed = windowStart != "" or windowEnd != ""
  resource window = loadTranscript(windowed ? openId : "", windowStart, windowEnd) as shape Window else empty()
  // The messages a search finds, the newest first
  resource matches = searchMessages(query.trim()) as shape Found[] else empty()
  mutation changed as shape Change queue refreshes inbox, matches, window then afterChange
  mutation drafted as shape Change queue refreshes inbox
  derive openId = top(nav).name == "thread" ? top(nav).params.id : ""
  derive conversation = match inbox.filter(t => t.id == openId).at(0) { case some(t) => t, case none => Thread(id="", name="", short="", initials="", phone="", email="", draft="", reply="", serial=0, count=0, recent=[], hasEarlier=false, earlier="") }
  // The messages the transcript shows: the window's once it has answered,
  // else the latest; and whether they reach the conversation's end
  derive loaded = windowed and window.contact == openId and window.rows.length > 0 ? window.rows : conversation.recent
  derive atEnd = not windowed or window.contact != openId or not window.hasLater
  derive draft = editing == openId ? editedDraft : conversation.draft
  derive reply = editing == openId ? editedReply : conversation.reply
  derive now = wall.epochAtZero + elapsed
  derive needle = query.trim().toLowerCase()
  // The conversations a search finds by name; its messages are `matches`
  derive shown = inbox.filter(t => needle == "" or t.name.toLowerCase().includes(needle))
  derive noResults = needle != "" and shown.length == 0 and matches.length == 0 and not pending(matches)
  derive composerHeight = max(60, min(263.158, viewport.height * 0.45))
  // A one-line balloon's corners: half its height
  derive balloonRadius = (bodySize * 1.193359 + 20) / 2
  // A receipt shows under the newest of your messages since their last one
  // that has been delivered: never under one they have answered. Read from
  // the rows shown where they reach the conversation's end: one before them
  // is answered or older
  derive answered = match loaded.filter(m => not m.mine).at(-1) { case some(theirs) => loaded.map(m => m.id).indexOf(theirs.id) + 1, case none => 0 }
  derive receiptId = atEnd ? match loaded.slice(answered).filter(m => m.receipt != "" or now - m.at >= 1130).at(-1) { case some(m) => m.id, case none => "" } : ""
  derive awaitingReceipt = atEnd and loaded.filter(m => m.mine and m.receipt == "" and now - m.at < 2000).length > 0
  derive sendError = match changed { case some(c) => c.error, case none => "" }
  // The platform's send: the copy narrows to its balloon in 200 ms and comes
  // from 0.6 to whole as it does. It slides to the row's side and, 55 ms
  // later, rises, both on one underdamped spring. It shrinks about its right
  // side on one spring, and from 185 ms grows back by the inverse on another.
  derive flightMotion = flightPhase >= 3 ? "translate -exact-spring(141.759, 17.3503, 1), scale -exact-spring(310, 38, 2), opacity 200ms ease-in" : "none"
  derive swellMotion = flightPhase >= 4 ? "scale -exact-spring(320, 38, 2)" : "none"
  derive narrowMotion = flightPhase >= 3 ? "translate 200ms cubic-bezier(0.541951, 0, 0.58, 1)" : "none"
  derive flightNarrowed = flightPhase >= 3 ? flightNarrow : 0
  derive transcript = loaded.concat(typing ? [Message(id="typing", body="", mine=false, at=0, reply="", stamped=false, endsRun=true, last=true, receipt="", readAt=0)] : [])

  action edit(value: string)
    write(value, reply)
  action write(text: string, quoted: string)
    editing = openId
    editedDraft = text
    editedReply = quoted
    send drafted = command("draft", openId, text, quoted, wall.epochAtZero + performanceNow())
  action fontChanged(width: number, height: number)
    bodySize = height
  action began
    // The newest message comes up with the keys, the latest shown again
    // where the reader had scrolled away from them
    if not atEnd
      latest()
    let newest = match (atEnd ? transcript : conversation.recent).at(-1) { case some(m) => m.id, case none => "" }
    if newest != ""
      scrollIntoView("transcript", newest, block="end")
  // The conversation's latest messages, which the list answers with it
  action latest
    windowStart = ""
    windowEnd = ""
  // The reader reached the first row shown: the 50 before it, as ChatKit
  // loads them, the window letting go of rows past 200 at its other end
  action older
    if windowed and window.contact == openId
      if window.hasEarlier
        windowStart = window.earlier
        windowEnd = window.earlierEnd
    else if conversation.hasEarlier
      windowStart = conversation.earlier
      windowEnd = ""
  // The reader reached the last row shown, not the conversation's: the 50
  // after it
  action newer
    if windowed and window.contact == openId and window.hasLater
      windowEnd = window.later
      windowStart = window.laterStart
  action send
    if draft.trim() != "" and not pending(changed)
      submitted = draft
      submittedReply = reply
      elapsed = performanceNow()
      flightBody = draft.trim()
      // The id the send saves it with: the data module's overlay shows its
      // row from this commit, before the file has it
      let id = `sent-${conversation.serial + 1}`
      flightId = id
      flightAt = performanceNow()
      flightRise = 0
      flightSlide = 0
      let page = frame("conversation")
      let rows = frame("transcript")
      let pill = frame("composer-pill")
      flightLeft = rows.x - page.x
      flightRight = page.x + page.width - rows.x - rows.width
      flightBottom = page.y + page.height - pill.y - pill.height
      fieldX = pill.x
      fieldRight = pill.x + pill.width
      // It shrinks less from a taller field: to 0.7 from one line, to 0.9
      // from seven
      flightScale = 0.7 + 0.2 * max(0, min(1, (pill.height - 40.3333) / (6 * 40.3333)))
      let flies = not (viewport.prefersReducedMotion or page.unavailable or pill.unavailable)
      flightPhase = flies ? 1 : 0
      // A send shows the conversation's latest, where it lands
      if not atEnd
        latest()
      send changed = command("send", openId, draft.trim(), reply, wall.epochAtZero + performanceNow())
      // The transcript shows the new row at its end: the list moves the rows
      // the send shifts on one spring, a reader at the end and one scrolled
      // away alike
      scrollIntoView("transcript", id, block="end")
      // With no flight to take it, the draft leaves the field as the row shows
      if not flies
        write("", "")
  // The field keeps only what was typed after the send
  action handOff
    write(draft == submitted ? "" : draft, "")
  action afterChange
    let id = match changed { case some(c) => c.id, case none => "" }
    if sendError == "" and id.startsWith("sent-")
      // A flight not yet shown takes the draft from the field as it shows
      if flightPhase != 1
        handOff()
    if sendError == "" and id.startsWith("received-")
      arrivedId = id
    if sendError != ""
      flightPhase = 0
      // The flight took the draft from the field: it goes back
      if draft == ""
        write(submitted, submittedReply)
  action tick
    elapsed = performanceNow()
  task delivery when awaitingReceipt
    every(50, tick)
  action animate
    let stamp = performanceNow()
    if flightPhase == 1
      // The copy is laid out where the row's balloon will be, unseen: it is
      // shown as the field, which it takes the draft from in the same frame
      let flier = frame("flying-balloon")
      if not flier.unavailable
        flierBottom = flier.y + flier.height
        // It starts with its right side at the field's, as far left of the
        // row's, and its surface's left side where the field's is
        let slide = fieldRight - flier.x - flier.width
        flightSlide = slide
        flightReach = fieldX - frame("send-flight").x - slide
        flightNarrow = flier.x - fieldX + slide
        // From where the copy's text is laid out (the middle of a narrow
        // balloon) to where the field's was
        let words = frame("flying-balloon-text")
        flightShift = fieldX + 16 - slide - (words.unavailable ? flier.x + 14 : words.x)
        flightPhase = 2
        flightAt = stamp
        handOff()
      else if stamp - flightAt > 500
        flightPhase = 0
        handOff()
    else if flightPhase == 2 and stamp - flightAt >= 16
      flightShift = 0
      flightSlide = 0
      flightPhase = 3
      squashAt = stamp
    else if flightPhase >= 2 and stamp - flightAt > 2500
      flightPhase = 0
    else if flightPhase >= 3 and stamp - squashAt >= 995
      // The rise settles 935 ms in, the growth back 995 ms in
      flightPhase = 0
    else if flightPhase >= 3
      if flightPhase == 3 and stamp - squashAt >= 185
        flightPhase = 4
      if stamp - squashAt >= 55
        rise()
  // The copy rises to where its row comes to rest. The transcript scrolls
  // the row up from below its end, so it rests no lower than a last row's
  // balloon: above the transcript's padding and the row's own (14 and 2
  // points). A conversation too short to scroll leaves the row in place.
  action rise
    let rows = frame("transcript")
    let row = frame(`bubble-${flightId}`)
    let end = rows.y + rows.height - 16
    let bottom = row.unavailable ? end : min(row.y + row.height, end)
    if not rows.unavailable and max(bottom - flierBottom - flightRise, flightRise - bottom + flierBottom) > 0.5
      flightRise = bottom - flierBottom
  task sending when flightPhase > 0
    every(frame, animate)
  action menuOpened
    elapsed = performanceNow()
  action contactPressed
    elapsed = performanceNow()
    showPopover("conversation-menu")
  action landed
    arrivedId = ""
  task arrival when arrivedId != "" key=arrivedId
    after(300, landed)
  action receive
    typing = false
    flightPhase = 0
    elapsed = performanceNow()
    send changed = command("receive", openId, "That sounds perfect. See you soon!", "", wall.epochAtZero + performanceNow())
  action searchChats(value: string)
    query = value
  action toggleTyping
    typing = not typing
  action history
    send changed = command("history", openId, "", "", wall.epochAtZero + performanceNow())
  action reset
    editing = openId
    editedDraft = ""
    editedReply = ""
    typing = false
    send changed = command("reset", openId, "", "", wall.epochAtZero + performanceNow())
  action peek(id: string)
    peeked = id
  action card(id: string)
    carded = id
  action resetPeeked
    if editing == peeked
      editedDraft = ""
      editedReply = ""
    send changed = command("reset", peeked, "", "", wall.epochAtZero + performanceNow())
  action aim(id: string, body: string)
    selectedId = id
    selectedBody = body
  action copy
    copyText(selectedBody)
  action replyTo(body: string)
    write(draft, body)
    focus("composer")
  action replySelected
    write(draft, selectedBody)
    focus("composer")
  action cancelReply
    write(draft, "")
  // More… begins choosing, the balloon it came from chosen
  // The chosen messages' text is kept as each is chosen, as the rows shown
  // may load and let go of them before they are shared
  action more
    choosing = true
    chosen = [selectedId]
    picked = loaded.filter(m => m.id == selectedId).map(m => ChosenMessage(id=m.id, at=m.at, body=m.body))
  action choose(id: string)
    let was = chosen.includes(id)
    chosen = was ? chosen.filter(c => c != id) : chosen.concat([id])
    picked = was ? picked.filter(p => p.id != id) : picked.concat(loaded.filter(m => m.id == id).map(m => ChosenMessage(id=m.id, at=m.at, body=m.body)))
  action endChoosing
    choosing = false
    chosen = []
    picked = []
  action deleteChosen
    send changed = command("delete", openId, chosen.join("\n"), "", wall.epochAtZero + performanceNow())
    choosing = false
    chosen = []
    picked = []
  action shareChosen
    share(text=sortBy(picked, p => p.at).map(p => p.body).join("\n"))
  action follow(url: string)
    choosing = false
    chosen = []
    picked = []
    latest()
    if url.startsWith("/conversations/")
      selected = url.slice(15)
    typing = false
    flightPhase = 0
    arrivedId = ""
    // Beside the list a row swaps the open conversation, where a push would stack it
    if top(nav).name == "thread" and url.startsWith("/conversations/")
      nav = replace(nav, url)
    else
      nav = go(nav, url)
  action back
    nav = back(nav)
  // Beside the list, nothing selected (at launch, or as the iPhone Duo
  // unfolds): the conversation last opened, else the newest. The app is not
  // told whether the platform's split shows the list beside a conversation,
  // so it opens one from the width the web splits at, 900: the open Duo, an
  // iPad turned sideways and a large iPhone's landscape split there, and no
  // phone opens a conversation over its list. An upright iPad, which splits
  // narrower, shows the platform's empty detail instead
  task select when viewport.width >= 900 and top(nav).name == "inbox" and inbox.length > 0
    after(1, reopen)
  action reopen
    if top(nav).name == "inbox"
      let last = match inbox.filter(t => t.id == selected).at(0) { case some(t) => t.id, case none => "" }
      let newest = match inbox.at(0) { case some(t) => t.id, case none => "" }
      let id = last != "" ? last : newest
      if id != ""
        follow(path("thread", id))

  view
    main testId="app" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow interactive-widget="resizes-content" viewport-fit="cover" width="100%" height="100%" class=Canvas
      box position="absolute" width=0 height="1rem" resize=fontChanged aria-hidden=true pointer-events="none"
      for entry in stack(nav) key=entry.id
        if entry.name == "thread"
          // The route's content is laid out in the safe area, and the
          // transcript reaches the screen's sides by itself. The route takes
          // the bottom edge, where the composer docks in the home indicator's
          // band and pads by the route's inset there (LLP 1123 D4). What
          // lines up with the balloons (the rows, the typing indicator, the
          // flight and the composer) pads by the route's layout margins (LLP
          // 1123 D9). Its header is the
          // platform's bar, which the iPhone Duo's closed screen moves into
          // its side strip: the contact, a control with its avatar, is the
          // bar's title, and Options its trailing item.
          column id="conversation" navigationKey=`${entry.id}` -exact-safe-area="ignore bottom" position="absolute" inset=0 class=Canvas
            header display="flex" align-items="center"
              button press=contactPressed contextPopover="contact-menu" testId="contact" display="flex" align-items="center" gap=8
                column width="2.235294rem" height="2.235294rem" border-radius="1.117647rem" align-items="center" justify-content="center" class=Avatar
                  text conversation.initials font-size="1rem" class=Initials
                text conversation.short role="heading" aria-level=2 testId="contact-name"
              // Choosing, the bar trades Back and Options for Cancel: the
              // route's Back control, disabled, takes UIKit's Back away
              if choosing
                button id="back" disabled=true display="none"
                  text "Back"
                button press=endChoosing testId="end-choosing"
                  text "Cancel"
              else
                button press=menuOpened popovertarget="conversation-menu" aria-label="Conversation options" testId="options"
                  image "symbol:more"
            // Each conversation its own transcript: another's rows, whose ids
            // repeat, would move from where these were
            for open in [entry.params.id] key=open
              list id="transcript" testId="transcript" appearance="none" virtualized=true estimated-item-height=68 scroll-start="end" scrollFollowEnd=atEnd reachstart=older reachend=newer keyboardDismissMode="interactive" flex=1 min-height=0 padding-top=15.667 padding-bottom=14 scroll-padding-top=15.667 scroll-padding-bottom=14
                // A row that leaves (a deleted message, the typing
                // indicator) fades where it shows, as the rows the removal
                // moves go to their places on the platform's spring for a
                // batch update (a response of 0.3 s, no bounce; the fade's
                // curve is within 2% of it)
                for message in transcript key=message.id
                  column -exact-exit-animation="fade 350ms cubic-bezier(0.2, 0.1, 0.1, 1) both"
                    if message.id == "typing"
                      Typing(name=conversation.short, reduced=viewport.prefersReducedMotion)
                    else
                      MessageRow(message=message, receiptId=receiptId, now=now, utcOffset=wall.utcOffset, bodySize=bodySize, reduced=viewport.prefersReducedMotion, hidden=(flightPhase > 0 and flightId == message.id), arriving=(message.id == arrivedId), aim=aim, replyTo=replyTo, choosing=choosing, chosen=chosen.includes(message.id), choose=choose)
            if failed(inbox)
              text "The saved conversation could not be read. Use Conversation options to reset it." testId="load-error" color="-exact-system-red" font="-exact-footnote" padding=16 padding-left="var(--exact-layout-margins-inset-left)" padding-right="var(--exact-layout-margins-inset-right)"
            if flightPhase >= 1
              // Laid out as a row is, from the field's bottom, under the
              // composer's glass. While it is as wide as the field, a surface
              // reaching from the field's edge fills it out: it slides right
              // under the balloon, clipped inside the balloon's body, so its
              // left edge comes to the balloon's. Both shrink about the
              // balloon's right side with the row's scale, and grow back with
              // the one inside it.
              row id="send-flight" testId="send-flight" position="absolute" left=`calc(${flightLeft}px + var(--exact-layout-margins-inset-left))` right=`calc(${flightRight}px + var(--exact-layout-margins-inset-right))` bottom=flightBottom justify-content="flex-end" opacity=(flightPhase == 1 ? 0 : (flightPhase == 2 ? 0.6 : 1)) translate=`${flightSlide}px ${flightRise}px` scale=(flightPhase >= 3 ? flightScale : 1) transform-origin="100% 50%" transition=flightMotion pointer-events="none"
                row position="relative" flex=1 min-width=0 justify-content="flex-end" scale=(flightPhase >= 4 ? 1 / flightScale : 1) transform-origin="100% 50%" transition=swellMotion
                  box position="absolute" left=flightReach top=0 bottom=0 right=20 overflow="hidden"
                    box position="absolute" inset=0 border-radius=balloonRadius class=Sent translate=`${flightNarrowed}px 0px` transition=narrowMotion
                  box max-width="min(85%, calc(100% - 89.333333px))"
                    Balloon(body=flightBody, mine=true, tail=true, bodySize=bodySize, identifier="flying-balloon", shift=flightShift, shiftMotion=narrowMotion, tailMotion="none")
            if choosing
              ChoiceBar(count=chosen.length, share=shareChosen)
            else
              Composer(draft=draft, reply=reply, busy=pending(changed), maximumHeight=composerHeight, error=sendError, edit=edit, began=began, send=send, cancelReply=cancelReply, menuOpened=menuOpened)
        if entry.name == "inbox"
          // Its ground is the platform's: beside the conversation, UIKit's
          // sidebar, from the first frame, before its rows have loaded
          // (`navigationSplit`). Its bottom safe area takes in the keys while the search
          // is typed in: the list pads its end by it, so its last rows scroll
          // above them, and the empty state ends above it.
          column navigationKey=`${entry.id}` navigationSplit="320" position="absolute" inset=0
            header
              h2 "Chats"
              input type="search" value=query input=searchChats placeholder="Search" aria-label="Search conversations" testId="search"
            column flex=1 min-height=0 position="relative" display="flex" flex-direction="column"
              list appearance="auto" listStyle="plain" flex=1 min-height=0
                if needle == ""
                  section
                    for person in inbox key=person.id
                      ConversationRow(person=person, now=now, utcOffset=wall.utcOffset, large=viewport.accessibilityTextSize, peek=peek, card=card)
                // Searching: the conversations whose name matches, then the
                // messages whose text does
                if needle != "" and shown.length > 0
                  section
                    header
                      text "Conversations"
                    for person in shown key=person.id
                      ConversationRow(person=person, now=now, utcOffset=wall.utcOffset, large=viewport.accessibilityTextSize, peek=peek, card=card)
                if needle != "" and matches.length > 0
                  section
                    header
                      text "Messages"
                    for f in matches key=f.key
                      // A message found, as the platform shows one: its
                      // conversation's avatar, name and date over its text
                      // in a balloon, trimmed around the match, which is in
                      // the label's colour (white in a sent balloon) where
                      // the rest is secondary. It opens the conversation.
                      link href=path("thread", f.thread) testId=`found-${f.thread}-${f.message}` aria-label=`${f.name}, ${f.before}${f.match}${f.after}` display="flex" flex-direction="column" padding-top=12 padding-bottom=18 padding-left=16 padding-right=16 box-sizing="border-box"
                        row align-items="center" gap=8
                          column width=28 height=28 border-radius=14 align-items="center" justify-content="center" aria-hidden=true class=Avatar
                            text f.initials font-size=12.4444 class=Initials
                          text f.name font="-exact-headline" flex=1 min-width=0 line-clamp=1
                          text formatDay(f.at, now, wall.utcOffset, "list") font="-exact-subheadline" class=Secondary flex-shrink=0
                        row margin-top=8 justify-content=(f.mine ? "flex-end" : "flex-start")
                          text testId=`found-text-${f.thread}-${f.message}` max-width="calc(100% - 72px)" padding="10px 12px" box-sizing="border-box" border-radius=balloonRadius font-size=bodySize class=(f.mine ? Sent : Received) color=(f.mine ? "light-dark(#ffffff99, #ffffff99)" : "-exact-secondary-label")
                            text f.before
                            text f.match testId=`found-match-${f.thread}-${f.message}` color=(f.mine ? "light-dark(#ffffff, #ffffff)" : "-exact-label")
                            text f.after
              // No match: the platform's empty state, centred above the keys
              // over the empty list. The list stays, because the bar's search
              // field belongs to it.
              if noResults
                column position="absolute" top=0 left=0 right=0 bottom=0 display="flex" justify-content="center" testId="no-results"
                  EmptyState(symbol="symbol:search", title="No Results", message=`Nothing matches “${query.trim()}”.`)
      // The + card: opened from the + glass, it is UIKit's popover,
      // which grows out of the + and lies over the keys. Its rows are a
      // tinted tile and a label at the body's size.
      column id="add-menu" popover="auto" aria-label="Add to conversation" min-width=240 padding-top=11 padding-bottom=11
        button appearance="none" press=receive popovertarget="add-menu" popovertargetaction="hide" testId="receive" class=CardRow
          box class=CardTile background-color="-exact-system-blue"
            image "symbol:messages" class=CardGlyph
          text "Receive a message" class=Ink
        button appearance="none" press=toggleTyping popovertarget="add-menu" popovertargetaction="hide" testId="toggle-typing" class=CardRow
          box class=CardTile background-color="-exact-system-gray"
            image "symbol:ellipsis" class=CardGlyph
          text (typing ? "Stop typing indicator" : "Show typing indicator") class=Ink
      // The peek: the conversation's latest balloons, which open it, and
      // what can be done to it
      column id="conversation-peek" popover="auto" role="menu"
        for thread in inbox.filter(t => t.id == peeked) key=thread.id
          button contextPreview=true press=follow(path("thread", thread.id)) popovertarget="conversation-peek" popovertargetaction="hide" aria-label=`Open ${thread.name}` testId="peek-preview" display="flex" flex-direction="column" justify-content="flex-end" width="18.823529rem" padding-top=12 padding-bottom=12 box-sizing="border-box" class=Canvas
            for m in thread.recent.slice(-5) key=m.id
              row justify-content=(m.mine ? "flex-end" : "flex-start") padding-left=12 padding-right=12 padding-top=2 padding-bottom=(m.endsRun ? 8 : 2)
                box max-width="80%"
                  Balloon(body=m.body, mine=m.mine, tail=m.endsRun, bodySize=bodySize, identifier=`peek-${m.id}`, shift=0, shiftMotion="none", tailMotion="none")
        button press=resetPeeked popovertarget="conversation-peek" popovertargetaction="hide" destructive=true testId="peek-reset"
          text "Reset Conversation"
          image "symbol:refresh"
      // A long press on the contact in the bar: the bar lifts their avatar
      // alone, and the menu offers what their details allow, as the
      // platform's chat does in its title. Call, FaceTime and Mail are
      // links, which the system opens.
      column id="contact-menu" popover="auto" role="menu"
        link href=`tel:${conversation.phone}` testId="contact-call"
          text "Call"
          image "symbol:icon.call"
        link href=`facetime:${conversation.phone}` testId="contact-video"
          text "FaceTime"
          image "symbol:icon.video"
        link href=`mailto:${conversation.email}` testId="contact-mail"
          text "Mail"
          image "symbol:mail"
      // A long press on a person's avatar in the list: their card, as wide
      // as a row, with their avatar and name, over the actions their details
      // allow, in the platform's order. The card and Message open the
      // conversation.
      column id="person-card" popover="auto" role="menu"
        for person in inbox.filter(t => t.id == carded) key=person.id
          button contextPreview=true press=follow(path("thread", person.id)) popovertarget="person-card" popovertargetaction="hide" aria-label=`Open ${person.name}` testId="person-card" display="flex" align-items="center" gap=10 padding=10 width="calc(100cqw - 32px)" box-sizing="border-box" class=Canvas
            column width=60 height=60 border-radius=30 align-items="center" justify-content="center" class=Avatar
              text person.initials font-size=26.6667 class=Initials
            text person.name font="-exact-headline" line-clamp=2 testId="person-card-name"
          button press=follow(path("thread", person.id)) popovertarget="person-card" popovertargetaction="hide" testId="person-message"
            text "Message"
            image "symbol:messages"
          link href=`tel:${person.phone}` testId="person-call"
            text "Call"
            image "symbol:icon.call"
          link href=`facetime:${person.phone}` testId="person-video"
            text "Video"
            image "symbol:icon.video"
          link href=`mailto:${person.email}` testId="person-mail"
            text "Mail"
            image "symbol:mail"
      column id="conversation-menu" popover="auto" role="menu"
        button press=history popovertarget="conversation-menu" popovertargetaction="hide" testId="load-history"
          text "Load earlier messages"
          image "symbol:download"
        button press=reset popovertarget="conversation-menu" popovertargetaction="hide" destructive=true testId="reset"
          text "Reset conversation"
          image "symbol:refresh"
      // A long press on a balloon lifts it alone, tail included, over the
      // platform's order: Reply apart, then the rest, More… last, which
      // chooses messages to delete or share
      column id="message-menu" popover="auto" role="menu"
        button press=replySelected popovertarget="message-menu" popovertargetaction="hide" testId="reply-message"
          text "Reply"
          image "symbol:reply"
        hr
        button press=copy popovertarget="message-menu" popovertargetaction="hide" testId="copy-message"
          text "Copy"
          image "symbol:copy"
        button press=more popovertarget="message-menu" popovertargetaction="hide" testId="more-message"
          text "More…"
          image "symbol:more"
      // Deleting what was chosen asks first, in the platform's words: an
      // action sheet with no title
      dialog id="delete-messages" role="alertdialog" closedby="any"
        text (chosen.length == 1 ? "Are you sure you want to delete this message?" : "Are you sure you want to delete these messages?")
        button press=deleteChosen destructive=true commandfor="delete-messages" command="close" testId="confirm-delete"
          text (chosen.length == 1 ? "Delete Message" : `Delete ${chosen.length} Messages`)
        button commandfor="delete-messages" command="close" testId="cancel-delete"
          text "Cancel"

// A conversation in the list. The avatar sits in the row's leading padding,
// where a list cell's image sits, so the platform's line under the row starts
// at the name (45-point avatar, text 84 points in). At the accessibility text
// sizes (`large`) the row drops it and its text takes the width. A long press
// peeks at the conversation; on the avatar, it shows the person's card.
component ConversationRow
  props
    person: Thread
    now: number
    utcOffset: number
    large: bool
    peek: action
    card: action
  view
    link href=path("thread", person.id) testId=`conversation-${person.id}` aria-label=person.name contextmenu=peek(person.id) contextPopover="conversation-peek" position="relative" display="flex" flex-direction="column" gap=2 padding-top=12 padding-bottom=12 padding-right=16 padding-left=(large ? 16 : 84) min-height=69 justify-content="center" box-sizing="border-box"
      if not large
        row aria-hidden=true position="absolute" left=26 top=0 bottom=0 align-items="center"
          column width=45 height=45 border-radius=22.5 align-items="center" justify-content="center" contextmenu=card(person.id) contextPopover="person-card" testId=`avatar-${person.id}` class=Avatar
            text person.initials testId=`initials-${person.id}` font-size=20 class=Initials
      // The name, and when the latest message was sent: the time today,
      // Yesterday, the weekday this week, else the date
      row align-items="baseline" gap=8
        text person.name font="-exact-headline" flex=1 min-width=0 line-clamp=1
        text (match person.recent.at(-1) { case some(m) => formatDay(m.at, now, utcOffset, "list"), case none => "" }) testId=`sent-${person.id}` font="-exact-subheadline" class=Secondary flex-shrink=0
      text (match person.recent.at(-1) { case some(m) => m.body, case none => "" }) font="-exact-subheadline" line-clamp=2 class=Secondary
