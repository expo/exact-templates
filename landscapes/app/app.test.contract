test "a compact window launches on Landmarks" on ios, macos
  size 390x844
  clock settle
  expect tree has "route-landmarks"
  expect tree has "featured"

test "a card opens its landmark, and Favorite adds it to Favorites"
  at "/landmarks"
  clock settle
  tap "card-1002"
  clock settle
  expect text "detail-name" == "Serengeti"
  tap "favorite"
  clock data
  expect state cols.0 .landmarkIds.4 == "1002"

test "Favorite on a favorite takes it out of Favorites"
  at "/landmarks"
  clock settle
  tap "card-1001"
  clock settle
  tap "favorite"
  clock data
  expect state cols.0 .landmarkIds.0 == "1021"

test "Info keeps Map or Activities across a close and another landmark, as the sample's inspector does"
  at "/landmarks"
  clock settle
  tap "card-1016"
  clock settle
  tap "info"
  clock settle
  tap "segment-activities"
  clock settle
  // Closed, a sheet that Back dismisses; open, a column that goes with the page Back pops
  back
  clock settle
  type "app" "/landmark/1017"
  clock settle
  tap "info"
  clock settle
  expect state segment == "activities"
  expect tree has "info-activities"

test "Done in the landmark picker returns to the collection still being edited"
  at "/collection/1002"
  clock settle
  tap "edit-collection"
  clock settle
  tap "select-landmarks"
  clock settle
  tap "select-1003"
  clock data
  tap "select-done"
  clock settle
  expect tree has "done-editing"
  expect tree has "edit-name"
  expect state cols.1 .landmarkIds.4 == "1003"

test "Delete asks first, then removes the collection and leaves its page"
  at "/collection/1003"
  clock settle
  tap "edit-collection"
  clock settle
  tap "delete-collection"
  clock settle
  tap "delete-confirm"
  clock data
  clock settle
  expect state cols.2 .id == "1004"
  expect tree missing "route-collection"

test "Search finds landmarks within Home and Back from a result keeps the query"
  size 390x844
  at "/"
  clock settle
  tap "search"
  clock settle
  type "search" "a"
  clock settle
  expect layout "search-list" height <= 844
  expect layout "search-list" height >= 1
  type "search" "mount"
  clock settle
  expect tree has "route-home"
  expect tree has "result-1016"
  expect tree has "result-1007"
  expect tree missing "result-1017"
  expect state visitDepth == 1
  type "search" "Asia"
  clock settle
  expect tree has "result-1017"
  expect tree missing "result-1007"
  expect state visitDepth == 1
  type "search" "zzz"
  clock settle
  expect tree has "search-empty"
  type "search" "fuji"
  clock settle
  expect state visitDepth == 1
  tap "result-1016"
  clock settle
  expect text "detail-name" == "Mount Fuji"
  expect state visitDepth == 2
  back
  clock settle
  expect tree has "result-1016"
  expect state visitDepth == 1
  expect state query == "fuji"
  type "search" ""
  clock settle
  expect tree has "page-map"
  tap "page-map"
  clock settle
  expect tree has "route-map"
  expect state visitDepth == 2

test "The map reaches its route's edges, under the bars, the sidebar and the home indicator"
  at "/map"
  clock settle
  expect layout "map" top == layout "route-map" top
  expect layout "map" right == layout "route-map" right
  expect layout "map" bottom == layout "route-map" bottom
  expect layout "map" left == layout "route-map" left

test "A search result opens over the selected page, which Back from it keeps" on web
  size 1200x800
  at "/landmarks"
  clock settle
  tap "search"
  clock settle
  type "search" "fuji"
  clock settle
  tap "result-1016"
  clock settle
  expect text "detail-name" == "Mount Fuji"
  expect state visitDepth == 3
  back
  clock settle
  expect state visitDepth == 2
  expect tree has "route-landmarks"
  expect tree has "result-1016"
  expect state query == "fuji"

test "Home keeps its ordinary rows reachable with results visible" on web, macos
  at "/"
  clock settle
  tap "search"
  clock settle
  type "search" "fuji"
  clock settle
  expect tree has "result-1016"
  tap "page-map"
  clock settle
  expect tree has "route-map"
  expect state query == "fuji"

test "A landmark's tile in a collection opens the card's menu, whose Favorite adds it to Favorites"
  at "/collection/1002"
  clock settle
  tap "tile-1018" contextmenu
  expect state aimed == "1018"
  tap "Favorite"
  clock data
  expect state cols.0 .landmarkIds.4 == "1018"

test "A search result opens the card's menu, whose Favorite adds it to Favorites"
  at "/"
  clock settle
  tap "search"
  clock settle
  type "search" "mount"
  clock settle
  tap "result-1016" contextmenu
  expect state aimed == "1016"
  tap "Favorite"
  clock data
  expect state cols.0 .landmarkIds.4 == "1016"

test "A card carries its landmark's name and photo for a drag"
  at "/landmarks"
  clock settle
  expect drag "card-1016" has "image/jpeg" name "1016.jpg"
  expect drag "card-1016" has "text/plain" == "Mount Fuji"

test "A collection's tile carries its landmark's name and photo for a drag"
  at "/collection/1002"
  clock settle
  expect drag "tile-1018" has "image/jpeg" name "1018.jpg"
  expect drag "tile-1018" has "text/plain" == "Mount Everest"
