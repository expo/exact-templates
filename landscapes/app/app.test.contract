test "a compact width opens on the Landmarks page"
  clock settle
  expect tree has "route-landmarks"
  expect tree has "featured"

test "a card opens its landmark, and Favorite adds it to Favorites"
  clock settle
  tap "card-1002"
  clock settle
  expect text "detail-name" == "Serengeti"
  tap "favorite"
  clock data
  expect state cols.0 .landmarkIds.4 == "1002"

test "Favorite on a favorite takes it out of Favorites"
  clock settle
  tap "card-1001"
  clock settle
  tap "favorite"
  clock data
  expect state cols.0 .landmarkIds.0 == "1021"

test "Info keeps Map or Activities across a close and another landmark, as the sample's inspector does"
  clock settle
  tap "card-1016"
  clock settle
  tap "info"
  clock settle
  tap "segment-activities"
  clock settle
  // Closed, a sheet that Back dismisses; open, a column that goes with the page Back pops
  back
  clock settle
  type "app" "/landmark/1017"
  clock settle
  tap "info"
  clock settle
  expect state segment == "activities"
  expect tree has "info-activities"

test "Done in the landmark picker returns to the collection still being edited"
  at "/collection/1002"
  clock settle
  tap "edit-collection"
  clock settle
  tap "select-landmarks"
  clock settle
  tap "select-1003"
  clock data
  tap "select-done"
  clock settle
  expect tree has "done-editing"
  expect tree has "edit-name"
  expect state cols.1 .landmarkIds.4 == "1003"

test "Delete asks first, then removes the collection and leaves its page"
  at "/collection/1003"
  clock settle
  tap "edit-collection"
  clock settle
  tap "delete-collection"
  clock settle
  tap "delete-confirm"
  clock data
  clock settle
  expect state cols.2 .id == "1004"
  expect tree missing "route-collection"

test "Search finds landmarks by name or by continent, as a level on top of the stack; another page leaves it and keeps the text"
  at "/"
  clock settle
  type "search" "mount"
  clock settle
  expect tree has "route-search"
  expect tree has "result-1016"
  expect tree has "result-1007"
  expect tree missing "result-1017"
  type "search" "Asia"
  clock settle
  expect tree has "result-1017"
  expect tree missing "result-1007"
  type "search" "zzz"
  clock settle
  expect tree has "search-empty"
  // Another page chosen from the list leaves the results, and the field keeps what was typed
  type "app" "/map"
  clock settle
  expect state query == "zzz"
  expect tree missing "route-search"

test "A result opens over the results and Back returns to them; Back from them leaves them and keeps the text"
  at "/"
  clock settle
  type "search" "fuji"
  clock settle
  tap "result-1016"
  clock settle
  expect text "detail-name" == "Mount Fuji"
  expect state query == "fuji"
  // The results stay under the page a result opened, so Back shows them as UIKit's pop begins
  expect tree has "search-results"
  back
  clock settle
  expect tree has "result-1016"
  // Emptying the field keeps the level, which shows only its ground
  type "search" ""
  clock settle
  expect tree has "route-search"
  expect tree missing "search-results"
  type "search" "fuji"
  clock settle
  back
  clock settle
  expect tree missing "route-search"
  expect state query == "fuji"
